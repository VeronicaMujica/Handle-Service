PORT=3000

# MongoDB local o en Docker
MONGODB_URI=mongodb://127.0.0.1:27017/handle_service

# MongoDB Atlas
# MONGODB_URI=mongodb+srv://USUARIO:CLAVE@cluster0.xxxxx.mongodb.net/handle_service

# Secreto para firmar los tokens JWT (cambiar en entornos reales)
JWT_SECRET=cambiar-esta-clave-antes-de-usar-en-produccion
JWT_EXPIRES_IN=8h
